# Besham Qila historical ERA5 configuration (CWatM).
# Active assignments preserved from the reviewed uncalibrated run.
# @ROOT@ and @OUTPUT@ are replaced by the workflow.
# Parameter changes are applied centrally by hydrology.py.
# Inactive process settings are retained for model compatibility.


[OPTIONS]
TemperatureInKelvin = True
gridSizeUserDefined = True
calc_evaporation = True
includeIrrigation = False
includeWaterDemand = False
usingAllocSegments = False
limitAbstraction = True
fossil_water_treated_normally = True
sectorSourceAbstractionFractions = True
calc_environflow = False
preferentialFlow = False
CapillarRise = True
includeRunoffConcentration = True
includeWaterBodies = False
includeRouting = True
inflow = False
writeNetcdfStack = True
reportMap = False
reportTss = True
calcWaterBalance = False
sumWaterBalance = False
PCRaster = False
includeGlaciers = True
usepySnowClim = False
savebasinmap = True

[FILE_PATHS]
PathRoot = @ROOT@/data/cwatm/spatial/30min/cwatm_input_30min
PathOut = @OUTPUT@
PathMaps = @ROOT@/data/cwatm/spatial/30min/cwatm_input_30min
PathMeteo = @ROOT@/data/climate/era5/processed/daily_2005_2019/cwatm_050deg
PathWaterdemand = $(PathMaps)/landsurface/waterDemand

[NETCDF_ATTRIBUTES]
